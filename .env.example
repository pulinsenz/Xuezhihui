# ============================================
# 学智汇 上线部署环境变量（docker compose 自动读取本文件注入容器）
# 用法：
#   cp .env.example .env
#   然后逐项填写。真实 .env 已被 .gitignore 忽略，切勿提交。
# 密钥生成：openssl rand -hex 32
# 注意：服务器上编辑请确保行尾为 LF（Windows 粘贴易带 CRLF 导致 source 异常）。
# ============================================

# ---- 必填 ----
# DeepSeek API Key（https://platform.deepseek.com 获取；管理员对话 / 默认 LLM）
DEEPSEEK_API_KEY=

# 普通用户 API Key（必填，普通用户对话专用 LLM 的密钥；走内部代理网关）
USER_API_KEY=

# 普通用户 LLM 模型 / 地址（可选，默认如下；代理账号另有 deepseek-v4-pro-0813，改 USER_LLM_MODEL 切换）
USER_LLM_MODEL=deepseek-v4-flash-0731
USER_LLM_BASE_URL=http://101.43.101.178:8080/v1

# Java ↔ Python 内部调用鉴权 token（两侧必须一致，>=32 字节随机值）
AGENT_TOKEN=

# JWT 签名密钥（Java 登录鉴权，>=32 字节随机值）
JWT_SECRET=

# ---- 人机验证（Cloudflare Turnstile，免费，防批量注册机器人）----
# 注册防刷。去 https://dash.cloudflare.com 的 Turnstile 创建站点，拿到 SITE_KEY 与 SECRET_KEY。
# SECRET_KEY 配给后端（本 .env），SITE_KEY 配给前端构建（本 .env 的 VITE_TURNSTILE_SITE_KEY，Docker 自动透传）。
# 未配置时注册接口开放（仅本地开发），上线必须配，否则批量注册薅 LLM token。
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# ---- 建议修改（有默认值，生产务必改）----
# 对话限流：普通用户窗口内对话次数上限（防脚本刷 LLM token，admin 不限）。
# 默认 50 次/30 分钟。按用户维度 Redis 计数，可在此调参：
#   在 java-backend application.yml 的 security.chat.max-count-per-window / window-minutes 修改，或部署注入同名环境变量。
# MySQL root 密码（默认 111111 仅本地开发；生产必须改为强随机，生成：openssl rand -hex 16）
MYSQL_ROOT_PASSWORD=111111

# MinIO 访问密钥（默认 minioadmin 仅本地开发；生产必须改为强随机：
#   MINIO_ACCESS_KEY  生成：openssl rand -hex 10
#   MINIO_SECRET_KEY  生成：openssl rand -hex 16
# 若修改，必须同步给 milvus 服务（docker-compose.yml 已透传 ${MINIO_ACCESS_KEY}/${MINIO_SECRET_KEY}），
# 否则 Milvus 无法读写对象存储）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Redis 访问密码（生产必设强随机，openssl rand -hex 16）。
# 留空则不鉴权（仅限本地开发）；设置后 docker compose 会自动传给 redis 服务与 java/python 连接，
# 无需改代码。作用是：防止内网其他容器/主机直接读写 Redis（登录白名单、限流计数、向量化任务队列）。
REDIS_PASSWORD=

# 初始管理员密码（首次启动 admin 账号不存在时以其创建，Java 启动时 BCrypt 落库）。
# 生产必设：openssl rand -base64 24。未设置则 Java 启动时生成随机密码并打印在日志里（仅一次）。
# 历史教训：admin 的哈希曾被硬编码进 init.sql 提交公开仓库，等于公开管理员凭据，现已移除。
ADMIN_PASSWORD=

# ---- 可选 ----
# 首次启动 python-agent 从 HF 下载 embedding 模型 ~130MB（已持久化到 hf-cache 卷，重建容器不重下）。
# 实测新版 huggingface_hub 对 hf-mirror.com 的 HEAD 元数据校验失败（FileMetadataError），故默认走官方源。

# ---- 腾讯云 COS（知识库封面对象存储，可选）----
# 不填则封面上传报「COS 未配置」；封面改存本地磁盘。填入后封面上传走 COS（私有桶内对象单独 public-read）。
COS_HOST=
COS_SECRETID=
COS_SECRETKEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
